{
  "name": "@interfaze-ai/ai-sdk-provider",
  "version": "0.1.0",
  "description": "Community Vercel AI SDK provider for Interfaze (interfaze.ai) — chat, structured output, guardrails, reasoning, and internal-task precontext on providerMetadata.",
  "type": "module",
  "license": "MIT",
  "author": "InterfazeAI",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm clean && tsup",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:pkg": "publint --strict && attw --pack --profile esm-only",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "qa:live": "tsx scripts/e2e-live.ts",
    "prepare": "tsup",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.30",
    "@ai-sdk/provider": "^4.0.7",
    "@ai-sdk/provider-utils": "^5.0.27"
  },
  "peerDependencies": {
    "zod": "^3.25.76 || ^4.1.8"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "ai": "^7.0.64",
    "prettier": "^3.9.6",
    "publint": "^0.3.23",
    "tsup": "^8.5.1",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.6",
    "zod": "3.25.76"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ai",
    "ai-sdk",
    "vercel-ai-sdk",
    "interfaze",
    "provider",
    "llm"
  ],
  "homepage": "https://github.com/InterfazeAI/interfaze-ai-sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/InterfazeAI/interfaze-ai-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/InterfazeAI/interfaze-ai-sdk/issues"
  }
}
